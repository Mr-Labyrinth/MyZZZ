<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Editor/BehaviourTreeEditor.uss?fileID=7433441132597879392&amp;guid=a2cd9c8bd5bb6514eb9fbf68118fc75b&amp;type=3#BehaviourTreeEditor" />
    <editor:Toolbar>
        <editor:ToolbarMenu text="Assets " />
    </editor:Toolbar>
    <SplitView fixed-pane-initial-dimension="300">
        <engine:VisualElement style="flex-grow: 1;">
            <engine:Label text="Inspector" style="background-color: rgb(20, 20, 20);" />
            <InspectorView />
        </engine:VisualElement>
        <engine:VisualElement style="flex-grow: 1;">
            <engine:Label text="Tree View" style="background-color: rgb(20, 20, 20);" />
            <BehaviourTreeView name="BehaviourTreeView" style="flex-grow: 1;" />
        </engine:VisualElement>
    </SplitView>
</engine:UXML>
